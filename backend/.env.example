# ==============================================================================
# HomiQ Backend Environment Configuration Template
# Copy this file to .env and configure environment-specific values.
# ==============================================================================

# ── Application Environment ──────────────────────────────────────────────────
ENV=development
DEBUG=True
PORT=8000
SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (PostgreSQL) Configuration ───────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=homiq_db
DATABASE_URL=postgresql+psycopg://postgres:postgres_secure_password@postgres:5432/homiq_db

# ── Redis Cache, Pub/Sub & Celery Broker Configuration ────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_RESULT_BACKEND=redis://redis:6379/1

# ── Integration Services (Google Maps, Razorpay, Cloudinary) ──────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# ── Multi-Channel Notifications (SMTP Email & SMS) ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@homiq.com
SMTP_PASSWORD=your_smtp_app_password
SMS_API_KEY=your_sms_gateway_api_key
