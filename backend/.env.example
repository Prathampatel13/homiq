# ==============================================================================
# HomiQ Backend Environment Configuration Template
# Copy this file to .env and configure environment-specific values.
# ==============================================================================

# ── Application Environment ──────────────────────────────────────────────────
ENV=development
DEBUG=True
PORT=8000
SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database (PostgreSQL) Configuration ───────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=homiq_db
DATABASE_URL=postgresql://postgres:postgres@123@postgres:5432/homiq_db

# ── Redis Cache, Pub/Sub & Celery Broker Configuration ────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_RESULT_BACKEND=redis://redis:6379/1

# ── Integration Services (Google Maps, Razorpay, Cloudinary) ──────────────────
GOOGLE_MAPS_API_KEY=AIzaSyDZLueyk2lZjwzzjTJR1jxO-jhgLx9Kjeg
RAZORPAY_KEY_ID=rzp_test_TWt6Xac7o9V7dd
