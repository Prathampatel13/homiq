# ==============================================================================
# HomiQ Backend Environment Configuration
# Copy this file to .env and fill in environment-specific values.
# ==============================================================================

# ── REQUIRED (App will NOT start without these) ──────────────────────────────
DATABASE_URL=sqlite:///./homiq.db
# For production (Neon.tech free PostgreSQL):
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/homiq_db?sslmode=require

SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_min_32_chars
ALGORITHM=HS256

# ── OPTIONAL (defaults shown, app works without them) ────────────────────────
ENV=development
DEBUG=True
PORT=8000
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Integration Services (leave empty to use built-in mocks/fallbacks) ───────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=

# ── Email / SMTP (leave empty to skip email sending) ─────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ── SMS (leave empty to skip SMS sending) ────────────────────────────────────
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=

# ── Redis (OPTIONAL — app uses in-memory fallback if unavailable) ────────────
# REDIS_URL=redis://localhost:6379/0
# REDIS_BROKER_URL=redis://localhost:6379/0
# REDIS_RESULT_BACKEND=redis://localhost:6379/1
